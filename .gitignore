# Clipman CLI caret trace. --debug writes it beside the program and it records
# the text under the cursor, which is clip content.
clipman-tui-debug.txt

# The cross-client interoperability corpus is synthetic data generated by
# tools/ClipmanFixtures, not user history, and the fixture tests cannot run on a
# fresh clone without it. The blanket *.clipdb rule above still covers real
# history files everywhere else.
!ClipmanCli/testdata/fixtures/**/*.clipdb
